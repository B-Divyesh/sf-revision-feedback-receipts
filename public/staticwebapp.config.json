{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "/demo/*", "/privacy/*", "/terms/*", "/404.html", "/*.svg", "/*.xml", "/*.txt", "/*.webmanifest", "/sw.js"]
  },
  "routes": [
    {
      "route": "/demo",
      "rewrite": "/demo/index.html"
    },
    {
      "route": "/assets/*",
      "headers": { "cache-control": "public, max-age=31536000, immutable" }
    },
    {
      "route": "/sw.js",
      "headers": { "cache-control": "no-cache" }
    }
  ],
  "responseOverrides": {
    "404": { "rewrite": "/404.html", "statusCode": 404 }
  },
  "globalHeaders": {
    "content-security-policy": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'",
    "referrer-policy": "strict-origin-when-cross-origin",
    "x-content-type-options": "nosniff",
    "permissions-policy": "camera=(), microphone=(), geolocation=()"
  }
}
