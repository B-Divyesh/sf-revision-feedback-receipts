{
  "name": "revision-feedback-receipts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "overrides": {
    "playwright-core": "1.58.2"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run tests/diff.test.ts",
    "test:e2e": "npm run build && playwright test",
    "test:claims": "npm run build && node scripts/run-claims.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.58.2",
    "@types/node": "24.3.0",
    "eslint": "^9.39.5",
    "typescript": "5.9.2",
    "typescript-eslint": "^8.68.0",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
